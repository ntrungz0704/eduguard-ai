  "description": "Cung cấp kiến thức nền tảng cho người học tiếng Anh ở mức độ sơ cấp. Người học rèn luyện kỹ năng nghe nói đọc viết, từ vựng và ngữ pháp cơ bản thông qua các bài hội thoại, video, bài giảng liên quan đến những chủ đề quen thuộc trong cuộc sống như: làm quen, thảo luận về sở thích nghe nhạc, nói về gia đình, các hoạt động hằng ngày và thường niên, các hoạt động trong thời gian rảnh, mô tả địa điểm, hỏi và chỉ đường, hỏi và làm rõ thông tin.",
  "prerequisites": [],
  "tools_required": [],
  "learning_outcomes": [
    {
      "code": "CLO1",
      "title": "Kỹ năng nghe",
      "details": "Có khả năng nghe để lấy thông tin chi tiết, nghe ý chính, nghe và ghi chú hay phân loại, nghe để dự đoán...trong những tình huống đơn giản"
    },
    {
      "code": "CLO2",
      "title": "Kỹ năng nói",
      "details": "Sử dụng từ vựng và cấu trúc ngữ pháp đã học để nói và trình bày thông tin, so sánh đặc điểm, đưa ra yêu cầu... trong những tình huống giao tiếp đơn giản, cụ thể."
    },
    {
      "code": "CLO3",
      "title": "Kỹ năng đọc",
      "details": "Đọc, tìm hiểu thông tin thông qua đoạn văn bản ngắn và đơn giản với nội dung khác nhau như thông tin cá nhân, sự kiện trên trang web, bài khảo sát, thực đơn"
    },
    {
      "code": "CLO4",
      "title": "Kỹ năng viết",
      "details": "Sử dụng được đúng cấu trúc ngữ pháp và từ vựng đã học để viết bài mô tả ngắn về mô tả người, sở thích âm nhạc, mô tả về gia đình hay nhà hàng yêu thích."
    }
  ],
