{
  "name": "eduguard-ai",
  "version": "1.0.0",
  "description": "EduGuard AI - Hệ thống dự đoán điểm sinh viên cho giảng viên",
  "main": "server/server.js",
  "type": "commonjs",
  "scripts": {
    "server": "node server/server.js",
    "client": "npm run dev --prefix client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "boot": "npm run kill && npm run build:client && concurrently \"npm run server\" \"npm run preview\"",
    "build:client": "npm run build --prefix client",
    "train": "node server/src/jobs/train.js",
    "train:chat": "node server/src/jobs/train_nlp.js",
    "boot:full": "npm run kill && npm run train && npm run train:chat && npm run build:client && concurrently \"npm run server\" \"npm run preview\"",
    "start": "node server/server.js",
    "preview": "npm run preview --prefix client -- --port 5173",
    "postinstall": "prisma generate",
    "kill": "node server/src/jobs/kill-ports.js",
    "test": "jest --passWithNoTests"
  },
  "keywords": [
    "ai",
    "education",
    "prediction",
    "linear-regression"
  ],
  "author": "EduGuard Team",
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "prisma": "^7.8.0",
    "@tensorflow/tfjs": "^4.22.0",
    "better-sqlite3": "^12.10.0",
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.4.7",
    "envalid": "^8.1.1",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "groq-sdk": "^1.2.0",
    "multer": "^1.4.5-lts.1",
    "node-nlp": "^5.0.0-alpha.5",
    "pptxgenjs": "^4.0.1",
    "uuid": "^14.0.0",
    "winston": "^3.19.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "autocannon": "^8.0.0",
    "concurrently": "^9.2.1",
    "jest": "^30.4.2",
    "supertest": "^7.2.2"
  }
}
