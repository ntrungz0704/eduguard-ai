// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../server/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String
  role          String         @default("ADVISOR") // ADMIN, ADVISOR, STUDENT
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  interventions Intervention[]
}

model Student {
  mssv          String         @id
  name          String
  classCode     String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  scores                  Score[]
  predictions             Prediction[]
  interventions           Intervention[]
  learningBoards          LearningBoard[]
  studentMemory           StudentMemory?
  learningProfile         LearningProfile?
  conversationHistories   ConversationHistory[]
  skillProfiles           SkillProfile[]
  recommendationHistories RecommendationHistory[]
  chatSessions            ChatSession[]
  learningProgresses      LearningProgress[]
  studentRoadmaps         StudentRoadmap[]
  interventionRoadmaps    InterventionRoadmap[] @relation("StudentInterventionRoadmaps")
  retakeRegistrations     RetakeRegistration[]
}

model Course {
  id            String         @id
  name          String
  credits       Int
  prerequisites String         @default("") // Comma-separated course IDs (e.g., "COM108,WEB105")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  scores        Score[]
  predictions   Prediction[]
  interventions Intervention[]
  retakeClasses RetakeClass[]
}

model Score {
  id         Int      @id @default(autoincrement())
  mssv       String
  courseId   String
  value      Float? // Nullable for currently studying / withdrew / test predicting
  attendance Float?  // To simulate Feature Engineering (e.g., 60%)
  quiz       Float?
  lab        Float?
  assignment Float?
  asm1       Float?
  asm2       Float?
  final      Float?
  semester   String
  status     String   @default("STUDYING") // PASSED, FAILED, STUDYING, NOT_STARTED
  rawScore   Float?   // The raw score uploaded by teacher
  computedScore Float? // The calculated weighted score
  importSessionId Int? // Links to the import session
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  student Student @relation(fields: [mssv], references: [mssv], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  importSession ImportSession? @relation(fields: [importSessionId], references: [id], onDelete: SetNull)
  components ScoreComponent[]

  @@unique([mssv, courseId, semester])
  @@index([mssv])
  @@index([courseId])
}

model Prediction {
  id             Int      @id @default(autoincrement())
  mssv           String
  courseId       String
  predictedScore Float
  risk           String   // HIGH, MEDIUM, LOW
  confidence     Float    @default(0.0) // E.g., 0.85 (85%)
  explanation    String?  // Textual reason explaining the risk for XAI
  reasons        String   // Stores structured XAI reasons array as JSON (maps to TEXT in SQLite)
  createdAt      DateTime @default(now())

  student Student @relation(fields: [mssv], references: [mssv], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([mssv, courseId])
  @@index([mssv])
  @@index([courseId])
}

model PredictionHistory {
  id             Int      @id @default(autoincrement())
  mssv           String
  courseId       String
  predictedScore Float
  predictionDate DateTime @default(now())
  
  @@index([mssv, courseId])
  @@index([courseId])
}

model PredictionEvaluation {
  id             Int      @id @default(autoincrement())
  mssv           String
  courseId       String
  predictedScore Float
  actualScore    Float
  absoluteError  Float
  squaredError   Float
  evaluationDate DateTime @default(now())

  @@index([mssv, courseId])
  @@index([courseId])
}

model Intervention {
  id        Int      @id @default(autoincrement())
  mssv      String
  courseId  String
  advisorId String
  action    String // Detailed description of support action
  status    String   @default("PENDING") // PENDING, ACTIVE, RESOLVED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [mssv], references: [mssv], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  advisor User    @relation(fields: [advisorId], references: [id], onDelete: Cascade)

  @@index([mssv])
  @@index([courseId])
  @@index([advisorId])
}

model Message {
  id          Int      @id @default(autoincrement())
  senderId    String   // Could be User ID (Advisor) or Student MSSV
  receiverId  String   // Could be User ID (Advisor) or Student MSSV
  content     String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  attachments Attachment[]

  @@index([senderId])
  @@index([receiverId])
}

model Attachment {
  id        Int      @id @default(autoincrement())
  messageId Int
  fileName  String
  fileUrl   String
  fileType  String   // 'image', 'document', etc.
  createdAt DateTime @default(now())

  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  
  @@index([messageId])
}

model LearningBoard {
  id        String   @id @default(uuid())
  studentId String
  careerId  String
  tasks     LearningTask[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student   Student  @relation(fields: [studentId], references: [mssv], onDelete: Cascade)

  @@unique([studentId, careerId])
  @@index([studentId])
}

model LearningTask {
  id             String        @id @default(uuid())
  boardId        String
  taskId         String        // ID in UI e.g., 'frontend_developer_task_1'
  title          String
  type           String
  status         String        @default("TODO")
  impact         Int
  duration       String
  startedAt      DateTime?
  completedAt    DateTime?
  github         String?
  demo           String?
  screenshot     String?
  evidenceStatus String        @default("NONE") // NONE, PENDING, VERIFIED
  verified       Boolean       @default(false)
  points         Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  board          LearningBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@index([boardId])
}

model StudentMemory {
  id                  String   @id @default(uuid())
  studentId           String   @unique
  careerGoal          String?
  learningStyle       String?
  strengths           String?  // JSON string
  weaknesses          String?  // JSON string
  currentSemester     Int?
  completedCourses    String?  // JSON string
  failedCourses       String?  // JSON string
  interestedSkills    String?  // JSON string
  lastRoadmap         String?  // JSON string
  lastRisk            String?  // JSON string
  conversationSummary String?  // Text summary of conversations
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [mssv], onDelete: Cascade)
}

model ConversationHistory {
  id String @id @default(uuid())
  studentId String
  role String // "USER" or "BOT"
  message String
  intent String?
  entities String? // JSON string
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [mssv], onDelete: Cascade)
  @@index([studentId])
}

model SkillProfile {
  id String @id @default(uuid())
  studentId String
  skillName String
  level String // e.g., "Beginner", "Intermediate", "Missing", "Advanced"
  source String // e.g., "CHAT_INFERRED", "MANUAL", "COURSE_PASSED"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [mssv], onDelete: Cascade)
  @@index([studentId])
  @@unique([studentId, skillName])
}

model CareerProfile {
  id String @id @default(uuid())
  careerId String @unique
  careerName String
  description String
  requiredSkills String // JSON string
  recommendedCourses String // JSON string
  portfolioProjects String // JSON string
  learningPath String // JSON string
  marketDemand String
  salaryRange String
  internshipRequirements String // JSON string
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LearningProfile {
  id String @id @default(uuid())
  studentId String @unique
  completedCourses String // JSON string
  failedCourses String // JSON string
  internshipTarget String?
  academicWarningCount Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [mssv], onDelete: Cascade)
}

model RecommendationHistory {
  id String @id @default(uuid())
  studentId String
  careerId String?
  recommendationType String // e.g., "ROADMAP", "SKILL_GAP", "PROJECT"
  content String // The recommended roadmap text or JSON
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [mssv], onDelete: Cascade)
  @@index([studentId])
}

model ChatSession {
  id String @id @default(uuid())
  studentId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [mssv], onDelete: Cascade)
  messages ChatMessage[]
  @@index([studentId])
}

model ChatMessage {
  id Int @id @default(autoincrement())
  sessionId String
  role String // "USER" or "BOT"
  message String
  intent String?
  entities String? // JSON string
  createdAt DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  @@index([sessionId])
}

model LearningProgress {
  id String @id @default(uuid())
  studentId String
  skillName String
  status String @default("TODO") // TODO, IN_PROGRESS, COMPLETED
  progress Int @default(0) // 0-100
  targetDate String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [mssv], onDelete: Cascade)
  @@index([studentId])
}

model StudentRoadmap {
  id String @id @default(uuid())
  studentId String
  skillName String // The central skill for this roadmap e.g. "Node.js"
  type String @default("30_DAYS") // 30_DAYS, 90_DAYS
  status String @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, DROPPED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [mssv], onDelete: Cascade)
  steps RoadmapStep[]
  @@index([studentId])
}

model RoadmapStep {
  id String @id @default(uuid())
  roadmapId String
  week Int
  title String
  description String
  status String @default("TODO") // TODO, COMPLETED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roadmap StudentRoadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  @@index([roadmapId])
}

model InterventionRoadmap {
  id               String    @id @default(uuid())
  studentId        String
  targetCourseId   String?
  riskLevel        String?
  riskReason       String?
  affectedCourses  String?   // JSON string array of affected course IDs
  missingSkills    String?   // JSON string array
  roadmap          String?   // JSON string
  sentDate         DateTime  @default(now())
  openedAt         DateTime?
  repliedAt        DateTime?
  completedAt      DateTime?
  improvementScore Float?
  advisorNotes     String?
  status           String    @default("PENDING") // PENDING, OPENED, IN_PROGRESS, COMPLETED

  student Student @relation("StudentInterventionRoadmaps", fields: [studentId], references: [mssv], onDelete: Cascade)
  @@index([studentId])
}

model RetakeClass {
  id             String               @id @default(uuid())
  courseId       String
  course         Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lecturerName   String
  schedule       String
  startDate      DateTime
  endDate        DateTime
  totalSeats     Int
  availableSeats Int
  status         String               @default("OPEN") // OPEN, CLOSED
  registrations  RetakeRegistration[]
  createdAt      DateTime             @default(now())
}

model RetakeRegistration {
  id             String       @id @default(uuid())
  studentId      String
  student        Student      @relation(fields: [studentId], references: [mssv], onDelete: Cascade)
  retakeClassId  String
  retakeClass    RetakeClass  @relation(fields: [retakeClassId], references: [id], onDelete: Cascade)
  status         String       @default("PENDING") // PENDING, APPROVED, REJECTED
  registeredAt   DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([studentId, retakeClassId])
}

model RetakeNotification {
  id          String   @id @default(uuid())
  recipientId String   // MSSV (Student) or Role (e.g. ADVISOR)
  message     String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

// ═══════════════════════════════════════════════════════════════
// DATA INTEGRITY MODELS
// ═══════════════════════════════════════════════════════════════

// Dynamic Course Alias mapping (replaces hardcoded courseCodeNormalizationMap)
// Allows admins to add new aliases without code changes
model CourseAlias {
  id         Int      @id @default(autoincrement())
  aliasCode  String   @unique  // The short/alternative code (e.g., "ENT111", "COM107", "tin học")
  courseCode String              // The canonical database Course.id (e.g., "ENT1128", "COM1071")
  source     String   @default("SYSTEM") // SYSTEM, ADMIN, IMPORT
  createdAt  DateTime @default(now())

  @@index([courseCode])
}

// Import Session for file deduplication and audit trail
model ImportSession {
  id              Int      @id @default(autoincrement())
  fileHash        String   @unique  // SHA-256 hash of the uploaded file
  fileName        String
  fileSize        Int
  uploadedBy      String   // User ID or MSSV of uploader
  studentsCount   Int      @default(0)
  scoresInserted  Int      @default(0)
  scoresUpdated   Int      @default(0)
  status          String   @default("SUCCESS") // SUCCESS, FAILED, ROLLED_BACK
  errorMessage    String?
  createdAt       DateTime @default(now())

  scores          Score[]
  components      ScoreComponent[]
}

model AssessmentSchema {
  id            Int      @id @default(autoincrement())
  courseCode    String
  curriculumVersion String @default("K19")
  componentCode String
  componentName String
  componentIndex Int     @default(1)
  orderNo       Int
  count         Int
  weightPercent Int      // stored as integer (e.g. 30 for 30%)
  isActive      Boolean  @default(true)
  effectiveFromSemester String?
  effectiveToSemester   String?
  createdAt     DateTime @default(now())

  @@unique([courseCode, curriculumVersion, componentCode, componentIndex])
  @@index([courseCode])
}

model ScoreComponent {
  id             Int      @id @default(autoincrement())
  scoreId        Int
  componentCode  String
  componentName  String
  componentIndex Int
  value          Float
  weightPercent  Int?     // stored as integer
  sourceColumn   String?
  sourceType     String   @default("EXCEL") // EXCEL, MANUAL, API, AI
  importSessionId Int?
  importedAt     DateTime @default(now())

  score          Score    @relation(fields: [scoreId], references: [id], onDelete: Cascade)
  importSession  ImportSession? @relation(fields: [importSessionId], references: [id], onDelete: SetNull)

  @@unique([scoreId, componentCode, componentIndex])
}
