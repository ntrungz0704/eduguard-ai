// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../server/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String
  role          String         @default("ADVISOR") // ADMIN, ADVISOR, STUDENT
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  interventions Intervention[]
}

model Student {
  mssv          String         @id
  name          String
  classCode     String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  scores        Score[]
  predictions   Prediction[]
  interventions Intervention[]
  learningBoards LearningBoard[]
}

model Course {
  id            String         @id
  name          String
  credits       Int
  prerequisites String         @default("") // Comma-separated course IDs (e.g., "COM108,WEB105")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  scores        Score[]
  predictions   Prediction[]
  interventions Intervention[]
}

model Score {
  id         Int      @id @default(autoincrement())
  mssv       String
  courseId   String
  value      Float? // Nullable for currently studying / withdrew / test predicting
  attendance Float?  // To simulate Feature Engineering (e.g., 60%)
  quiz       Float?
  lab        Float?
  assignment Float?
  asm1       Float?
  asm2       Float?
  final      Float?
  semester   String
  status     String   @default("STUDYING") // PASSED, FAILED, STUDYING, NOT_STARTED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  student Student @relation(fields: [mssv], references: [mssv], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([mssv, courseId, semester])
  @@index([mssv])
  @@index([courseId])
}

model Prediction {
  id             Int      @id @default(autoincrement())
  mssv           String
  courseId       String
  predictedScore Float
  risk           String   // HIGH, MEDIUM, LOW
  confidence     Float    @default(0.0) // E.g., 0.85 (85%)
  explanation    String?  // Textual reason explaining the risk for XAI
  reasons        String   // Stores structured XAI reasons array as JSON (maps to TEXT in SQLite)
  createdAt      DateTime @default(now())

  student Student @relation(fields: [mssv], references: [mssv], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([mssv, courseId])
  @@index([mssv])
  @@index([courseId])
}

model Intervention {
  id        Int      @id @default(autoincrement())
  mssv      String
  courseId  String
  advisorId String
  action    String // Detailed description of support action
  status    String   @default("PENDING") // PENDING, ACTIVE, RESOLVED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [mssv], references: [mssv], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  advisor User    @relation(fields: [advisorId], references: [id], onDelete: Cascade)

  @@index([mssv])
  @@index([courseId])
  @@index([advisorId])
}

model Message {
  id          Int      @id @default(autoincrement())
  senderId    String   // Could be User ID (Advisor) or Student MSSV
  receiverId  String   // Could be User ID (Advisor) or Student MSSV
  content     String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  attachments Attachment[]

  @@index([senderId])
  @@index([receiverId])
}

model Attachment {
  id        Int      @id @default(autoincrement())
  messageId Int
  fileName  String
  fileUrl   String
  fileType  String   // 'image', 'document', etc.
  createdAt DateTime @default(now())

  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  
  @@index([messageId])
}

model LearningBoard {
  id        String   @id @default(uuid())
  studentId String
  careerId  String
  tasks     LearningTask[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student   Student  @relation(fields: [studentId], references: [mssv], onDelete: Cascade)

  @@unique([studentId, careerId])
  @@index([studentId])
}

model LearningTask {
  id             String        @id @default(uuid())
  boardId        String
  taskId         String        // ID in UI e.g., 'frontend_developer_task_1'
  title          String
  type           String
  status         String        @default("TODO")
  impact         Int
  duration       String
  startedAt      DateTime?
  completedAt    DateTime?
  github         String?
  demo           String?
  screenshot     String?
  evidenceStatus String        @default("NONE") // NONE, PENDING, VERIFIED
  verified       Boolean       @default(false)
  points         Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  board          LearningBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@index([boardId])
}
