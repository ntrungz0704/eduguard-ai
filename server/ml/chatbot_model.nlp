  "nlgManager": {
    "settings": {
      "tag": "nlg-manager"
    },
    "responses": {
      "vi": {
        "ask.intro": [
          {
            "answer": "EduGuard AI là hệ thống Cảnh báo sớm và Can thiệp học vụ tự động. Hệ thống giúp dự đoán sinh viên có nguy cơ rớt môn dựa trên điểm các môn tiên quyết trong quá khứ để giảng viên kịp thời hỗ trợ."
          }
        ],
        "ask.features": [
          {
            "answer": "Hệ thống có 3 tính năng chính: 1. Cảnh báo Đỏ (Dự đoán rớt môn sớm bằng AI). 2. Quản lý Can thiệp (Theo dõi và gửi lộ trình khắc phục cho sinh viên). 3. Trợ lý ảo AI 24/7 (Chatbot tư vấn học tập)."
          }
        ],
        "ask.algorithm": [
          {
            "answer": "Hệ thống EduGuard sử dụng thuật toán Hồi quy tuyến tính (Linear Regression) kết hợp với Hệ số tương quan Pearson. AI phân tích điểm của các môn học tiên quyết (Prerequisites) để tính ra trọng số và dự đoán chính xác điểm môn tiếp theo."
          }
        ],
        "ask.pearson": [
          {
            "answer": "Ma trận Pearson đo lường mức độ tương quan giữa 2 môn học (từ -1 đến 1). Nếu sinh viên rớt môn A mà thường xuyên rớt môn B, hệ số Pearson sẽ tiến gần về 1. Hệ thống dùng hệ số này làm trọng số (weight) để dự đoán điểm."
          }
        ],
        "ask.redalert": [
          {
            "answer": "Cảnh báo đỏ (Red Alerts) là danh sách các sinh viên được AI dự đoán sẽ có điểm dưới 5.0 ở môn học mục tiêu. Hệ thống sẽ ghim những sinh viên này lên đầu để giảng viên ưu tiên can thiệp trước khi quá muộn."
          }
        ],
        "ask.prerequisite": [
          {
            "answer": "Môn tiên quyết là những môn học nền tảng. Ví dụ: Phải vững \"Lập trình C\" thì mới học tốt \"Cấu trúc dữ liệu\". EduGuard tìm ra các lỗ hổng kiến thức ở môn tiên quyết để báo động đỏ cho sinh viên."
          }
        ],
        "ask.how_upload": [
          {
            "answer": "Bạn có thể vào trang Chủ (Dashboard), bấm vào biểu tượng Tải lên hoặc kéo thả file Excel (danh sách điểm lớp hoặc bảng điểm cá nhân) vào khu vực upload. AI sẽ tự động đọc và làm sạch dữ liệu."
          }
        ],
        "ask.how_predict": [
          {
            "answer": "Sau khi upload file thành công, bạn chỉ cần chọn Môn học muốn dự đoán từ danh sách sổ xuống và bấm \"Phân tích rủi ro\". AI sẽ hiển thị biểu đồ và danh sách rớt môn ngay lập tức."
          }
        ],
        "greetings.hello": [
          {
            "answer": "Xin chào! Tôi là Trợ lý ảo Cục bộ của EduGuard AI (Chạy Offline không cần Internet). Tôi có thể giúp gì cho bạn về hệ thống này?"
          },
          {
            "answer": "Chào bạn! Tôi là Chatbot Local của EduGuard. Bạn muốn hỏi gì về tính năng hay thuật toán của dự án không?"
          }
        ],
        "greetings.bye": [
          {
            "answer": "Tạm biệt bạn. Chúc bạn một ngày làm việc hiệu quả với EduGuard!"
          }
        ],
        "greetings.thanks": [
          {
            "answer": "Không có chi! Rất vui được hỗ trợ bạn."
          }
        ]
      }
    }
  },
