    "responses": {
      "vi": {
        "ask.intro": [
          {
            "answer": "EduGuard AI là hệ thống Cảnh báo sớm và Can thiệp học vụ tự động sử dụng AI."
          }
        ],
        "ask.features": [
          {
            "answer": "Hệ thống có 3 tính năng chính: 1. Cảnh báo Đỏ (Dự đoán rớt môn bằng AI). 2. Quản lý Can thiệp (Theo dõi và gửi lộ trình khắc phục cho sinh viên). 3. Trợ lý AI Pipeline (Như tôi đây)."
          }
        ],
        "greetings.hello": [
          {
            "answer": "Xin chào! Tôi là Trợ lý AI Pipeline (Offline). Tôi có thể truy vấn CSDL để tìm ra những sinh viên sắp rớt hoặc môn học khó nhằn nhất. Bạn muốn hỏi gì?"
          }
        ]
      }
    }
  },
