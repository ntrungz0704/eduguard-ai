      "en": {
        "student_id": {
          "name": "student_id",
          "type": "regex",
          "rules": [
            "/[A-Za-z]{2}\\d{5}/gi"
          ]
        },
        "class_id": {
          "name": "class_id",
          "type": "regex",
          "rules": [
            "/[A-Za-z]{2,3}\\d{4,5}/gi"
          ]
        },
        "score": {
          "name": "score",
          "type": "regex",
          "rules": [
            "/\\b(10|[0-9](\\.[0-9]{1,2})?)\\s?(điểm|đ)?\\b/gi"
          ]
        },
        "attendance_range": {
          "name": "attendance_range",
          "type": "regex",
          "rules": [
            "/\\b(dưới |trên )?\\d{1,3}\\s?%\\b/gi"
          ]
        },
        "semester": {
          "name": "semester",
          "type": "enum",
          "rules": [
            {
              "option": "Spring 2026",
              "texts": [
