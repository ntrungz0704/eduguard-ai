        "ask.features": [
          {
            "answer": "Hệ thống EduGuard có 3 tính năng chính: 1. Cảnh báo Đỏ (Dự đoán rớt môn bằng AI). 2. Quản lý Can thiệp (Theo dõi và gửi lộ trình khắc phục). 3. Trợ lý AI Cố vấn (như tôi đang chat với bạn)."
          }
        ],
        "ask.algorithm": [
          {
            "answer": "EduGuard sử dụng thuật toán Hồi quy tuyến tính (Linear Regression) kết hợp với Hệ số tương quan Pearson. AI phân tích điểm của các môn học tiên quyết để tính ra trọng số dự đoán rủi ro rớt môn chính xác."
          }
        ],
        "greetings.hello": [
          {
            "answer": "Xin chào! Tôi là Trợ lý AI Pipeline (Chế độ Offline). Tôi có thể lấy dữ liệu trực tiếp từ CSDL để thống kê sinh viên rớt môn hoặc môn học khó nhất. Bạn cần tìm gì?"
          }
        ]
      }
