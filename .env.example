# ─────────────────────────────────────────────────────────────────────────────
# EduGuard AI — Environment Variables Template
# Copy this file to .env and fill in your own values.
# NEVER commit .env to Git. This file (.env.example) is safe to commit.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── CORS (Frontend URL — must match exactly) ─────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Database (SQLite for dev / PostgreSQL for production) ────────────────────
# SQLite (default for prototype — no extra setup needed):
DATABASE_URL="file:./dev.db"

# For PostgreSQL (Phase 2 migration — update to your PostgreSQL connection string):
# DATABASE_URL="postgresql://user:password@localhost:5432/eduguard_db?schema=public"

# ── Redis (optional — not required for core features) ────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT Authentication ────────────────────────────────────────────────────────
# IMPORTANT: Change this to a strong random secret in production!
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=eduguard_dev_secret_change_in_production_must_be_32_chars
JWT_EXPIRES_IN=7d

# ── AI / LLM API Keys (Optional — only needed for AI-enhanced chatbot) ────────
# Leave blank to use the built-in local NLP model (works offline)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3-32b

# ── Dynamic Grading / Assessment Components Architecture ─────────────────────
ENABLE_COMPONENT_SCORE=false
