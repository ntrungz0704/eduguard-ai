# ─────────────────────────────────────────────────────────────────────────────
# EduGuard AI — Environment Variables Template
# Copy this file to .env and fill in your own values.
# NEVER commit .env to Git. This file (.env.example) is safe to commit.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── CORS (Frontend URL — must match exactly) ─────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Database (SQLite for dev / PostgreSQL for production) ────────────────────
DATABASE_URL="file:./prisma/dev.db"

# For PostgreSQL (Phase 2 migration):
# DATABASE_URL="postgresql://eduguard:eduguard_dev_password@localhost:5432/eduguard_db"

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT Authentication (Phase 2) ─────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# ── AI / LLM API Keys ────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3-32b
